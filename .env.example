# LDA 自托管配置示例
# 用法：复制本文件为 .env，按需修改后 `docker compose up -d`
# 所有项均可选；不填则用 docker-compose.yml 中的默认值。

# 宿主机端口映射（宿主机端口:容器端口）
LDA_PORT=8787

# 部署形态：selfhost（默认自托管）| saas（P2.3 后可选，预留兼容）
DEPLOY_MODE=selfhost

# 数据目录（容器内的持久化路径，对应 lda-data 卷）
LDA_HOME=/data

# 多用户数据层（P2.2 落地后启用）
#   SQLite 起步：sqlite:////data/lda.db
#   托管 Postgres（SaaS-ready 兼容）：postgresql://user:pass@host:5432/lda
# LDA_DB_URL=sqlite:////data/lda.db

# 密钥（P2.2 多用户认证 / P2.3 license 用；务必替换为随机值，不要提交真值）
# LDA_SECRET_KEY=change-me-to-random
# LDA_LICENSE_KEY=
