<Slide style={{ width: 1280, height: 720, background: '#0A1120', padding: '64px 72px', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#E8EEF7' }}>九段征程 · 全程在 LDA 内闭环</Text>
        <Text style={{ fontSize: 19, color: '#2563EB', fontWeight: 'bold' }}>E1 基座 → E2 阵列 → E3 数据通路 → E4 规模 → E5 硬化 → E6 版图 → E7 寄生 → E8 失配 → E9 规模压力</Text>
        <Text style={{ fontSize: 16, color: '#9FB3CC' }}>门禁合计 188 判据（含 31 条突变探针）+ 10 道常驻门禁 · D-150…D-159 · E10（D-160）收官。</Text>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 34, alignItems: 'flex-start' }}>
        <Box style={{ flexDirection: 'column', gap: 14, flex: 1 }}>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 34 }}>E1</Text>
                <Box style={{ flexDirection: 'column', gap: 1, flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7' }}>基座：晶体管模型 + MNA 仿真器 + 最小计算单元</Text>
                    <Text style={{ fontSize: 13, color: '#9FB3CC', lineHeight: 1.45 }}>RC 瞬态 vs 指数 &lt;2e-4 · AC vs 闭式 &lt;1e-13</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 34 }}>E2</Text>
                <Box style={{ flexDirection: 'column', gap: 1, flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7' }}>参数化 N×M 模拟 MVM 交叉阵列</Text>
                    <Text style={{ fontSize: 13, color: '#9FB3CC', lineHeight: 1.45 }}>理想 8×8 &lt;2e-4 · transistor 4×4 &lt;2.4e-4 · OTA 增益 ∝ Rd</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 34 }}>E3</Text>
                <Box style={{ flexDirection: 'column', gap: 1, flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7' }}>MVM 数据通路（DAC→阵列→ADC、多层、分块）</Text>
                    <Text style={{ fontSize: 13, color: '#9FB3CC', lineHeight: 1.45 }}>单层 8bit 0.0122 · 2 层 MLP 0.044 · 分块=全阵</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 34 }}>E4</Text>
                <Box style={{ flexDirection: 'column', gap: 1, flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7' }}>规模对标（至 256×256 = 65536 突触）</Text>
                    <Text style={{ fontSize: 13, color: '#9FB3CC', lineHeight: 1.45 }}>相对误差有界 0.018→0.030 · 绝对误差 ∝N 0.08→0.54</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 34 }}>E5</Text>
                <Box style={{ flexDirection: 'column', gap: 1, flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7' }}>平台能力硬化：能力清单 + 守护门禁</Text>
                    <Text style={{ fontSize: 13, color: '#9FB3CC', lineHeight: 1.45 }}>清单 ↔ 模块/符号 双向完备 · 诚实边界机器化</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 14, flex: 1 }}>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 34 }}>E6</Text>
                <Box style={{ flexDirection: 'column', gap: 1, flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7' }}>版图与几何签核（首次直出真 GDS）</Text>
                    <Text style={{ fontSize: 13, color: '#9FB3CC', lineHeight: 1.45 }}>4×4 = 120 元素 / 8.40×8.90 µm² / GDS 936 B · 8×8 双 ACCEPT</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 34 }}>E7</Text>
                <Box style={{ flexDirection: 'column', gap: 1, flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7' }}>寄生提取与后仿（有阻互连）</Text>
                    <Text style={{ fontSize: 13, color: '#9FB3CC', lineHeight: 1.45 }}>R□ = 0.084 Ω/□ · IR drop N=4 0.42%→N=32 27.0% · sneak 7.26×</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 34 }}>E8</Text>
                <Box style={{ flexDirection: 'column', gap: 1, flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7' }}>非理想/失配/噪声 + 校准层级</Text>
                    <Text style={{ fontSize: 13, color: '#9FB3CC', lineHeight: 1.45 }}>σ_ΔVth 5.00 mV · σ_rel·√N ≈ 0.0186（1/√N）· L0 1.70%→L2 0.074%</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 34 }}>E9</Text>
                <Box style={{ flexDirection: 'column', gap: 1, flex: 1 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E8EEF7' }}>千级阵列规模压力 + 诚实对标</Text>
                    <Text style={{ fontSize: 13, color: '#9FB3CC', lineHeight: 1.45 }}>1024² 层次化 GDS 86.6 KB · 压缩比 3571× · 5% 预算 ⇒ N≤18</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid rgba(159,179,204,0.25)', paddingTop: 16 }}>
        <Text style={{ fontSize: 16, color: '#9FB3CC' }}>LDA · 电子计算芯片（电子征程「吃狗粮」E1–E9 + E10 收官）</Text>
        <Text style={{ fontSize: 16, color: '#9FB3CC', fontFamily: 'Consolas' }}>03 / 06</Text>
    </Box>
</Slide>
