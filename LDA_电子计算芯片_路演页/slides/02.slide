<Slide style={{ width: 1280, height: 720, background: '#0A1120', padding: '64px 72px', flexDirection: 'column', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#E8EEF7' }}>吃狗粮 · 逼出并补齐平台八块真短板</Text>
        <Text style={{ fontSize: 20, color: '#2563EB', fontWeight: 'bold' }}>客户使用前，我们自己先使用并检验</Text>
        <Text style={{ fontSize: 17, color: '#9FB3CC', lineHeight: 1.6 }}>此前 LDA 电子域只到行为级——本征程新增 lda/lda_l2/ecore/ 包（12 模块 · 11 条能力面入册）逐一补齐。</Text>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 34, alignItems: 'flex-start' }}>
        <Box style={{ flexDirection: 'column', gap: 16, flex: 1 }}>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 30 }}>1</Text>
                <Box style={{ flexDirection: 'column', gap: 2, flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>无晶体管级模型</Text>
                    <Text style={{ fontSize: 15, color: '#9FB3CC', lineHeight: 1.5 }}>新增长沟道平方律 NMOS（三区 + gm/gds 解析）。</Text>
                    <Text style={{ fontSize: 13, color: '#5B7BB0', fontFamily: 'Consolas' }}>D-150 (E1)</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 30 }}>2</Text>
                <Box style={{ flexDirection: 'column', gap: 2, flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>无电路仿真器</Text>
                    <Text style={{ fontSize: 15, color: '#9FB3CC', lineHeight: 1.5 }}>新增 MNA 求解器（DC 牛顿 / 瞬态后向欧拉 / AC 复数）。</Text>
                    <Text style={{ fontSize: 13, color: '#5B7BB0', fontFamily: 'Consolas' }}>D-150 (E1)</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 30 }}>3</Text>
                <Box style={{ flexDirection: 'column', gap: 2, flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>无模拟计算原语</Text>
                    <Text style={{ fontSize: 15, color: '#9FB3CC', lineHeight: 1.5 }}>新增参数化 N×M MVM 阵列 + 数据通路（DAC→阵列→ADC）。</Text>
                    <Text style={{ fontSize: 13, color: '#5B7BB0', fontFamily: 'Consolas' }}>D-151/152 (E2/E3)</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 30 }}>4</Text>
                <Box style={{ flexDirection: 'column', gap: 2, flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>无规模定标与诚实护栏</Text>
                    <Text style={{ fontSize: 15, color: '#9FB3CC', lineHeight: 1.5 }}>新增层输出定标 + 诚实边界机器化护栏 + 能力清单。</Text>
                    <Text style={{ fontSize: 13, color: '#5B7BB0', fontFamily: 'Consolas' }}>D-153/154 (E4/E5)</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 16, flex: 1 }}>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 30 }}>5</Text>
                <Box style={{ flexDirection: 'column', gap: 2, flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>无版图链</Text>
                    <Text style={{ fontSize: 15, color: '#9FB3CC', lineHeight: 1.5 }}>新增电子版图层栈 + 1T 阵列 P&R + 几何 DRC/LVS + AREF 层次化 GDS。</Text>
                    <Text style={{ fontSize: 13, color: '#5B7BB0', fontFamily: 'Consolas' }}>D-156 (E6)</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 30 }}>6</Text>
                <Box style={{ flexDirection: 'column', gap: 2, flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>无寄生后仿</Text>
                    <Text style={{ fontSize: 15, color: '#9FB3CC', lineHeight: 1.5 }}>新增导线 RC 闭式 + R 梯网络 + IR drop / sneak path + Elmore。</Text>
                    <Text style={{ fontSize: 13, color: '#5B7BB0', fontFamily: 'Consolas' }}>D-157 (E7)</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 30 }}>7</Text>
                <Box style={{ flexDirection: 'column', gap: 2, flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>无失配/噪声模型</Text>
                    <Text style={{ fontSize: 15, color: '#9FB3CC', lineHeight: 1.5 }}>新增 Pelgrom 失配 + 温度 + 热/闪烁噪声 + Monte Carlo + 校准层级。</Text>
                    <Text style={{ fontSize: 13, color: '#5B7BB0', fontFamily: 'Consolas' }}>D-158 (E8)</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB', fontFamily: 'Consolas', width: 30 }}>8</Text>
                <Box style={{ flexDirection: 'column', gap: 2, flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#E8EEF7' }}>无千级规模能力</Text>
                    <Text style={{ fontSize: 15, color: '#9FB3CC', lineHeight: 1.5 }}>新增层次化 O(N) 出图 + 一维三对角 IR-drop + 可及规模上界。</Text>
                    <Text style={{ fontSize: 13, color: '#5B7BB0', fontFamily: 'Consolas' }}>D-159 (E9)</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid rgba(159,179,204,0.25)', paddingTop: 16 }}>
        <Text style={{ fontSize: 16, color: '#9FB3CC' }}>LDA · 电子计算芯片（电子征程「吃狗粮」E1–E9 + E10 收官）</Text>
        <Text style={{ fontSize: 16, color: '#9FB3CC', fontFamily: 'Consolas' }}>02 / 06</Text>
    </Box>
</Slide>
